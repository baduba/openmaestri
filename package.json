{
  "name": "openmaestri",
  "version": "0.17.0",
  "description": "Spatial canvas terminal workspace for AI agents (open implementation).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openmaestri": "bin/openmaestri.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "OPENMAESTRI_NO_WELCOME=1 node --test test/*.test.js",
    "check": "node --check src/server.js && node --check bin/openmaestri.js",
    "lint": "eslint src bin web test",
    "audit": "npm audit --omit=dev --audit-level=low"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.64.1"
  },
  "homepage": "https://baduba.github.io/openmaestri/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baduba/openmaestri.git"
  },
  "bugs": {
    "url": "https://github.com/baduba/openmaestri/issues"
  },
  "keywords": [
    "ai-agents",
    "terminal",
    "orchestrator",
    "deepseek",
    "opencode",
    "canvas"
  ],
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
